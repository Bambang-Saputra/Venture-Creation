<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug: HTTP biasa hanya ke php artisan serve di laptop, lewat emulator (10.0.2.2)
    atau adb reverse (127.0.0.1). HP fisik memakai URL https ngrok.
    Kalau memakai cadangan hotspot LAN, tambahkan IP laptop di sini secara lokal, jangan di-commit.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
