<?xml version="1.0" encoding="utf-8"?>
<!--
    Gaya teks dan komponen dari Figma (halaman Fondasi dan Komponen).
    Figma memakai Gabarito 800 untuk judul dan Figtree 400-700 untuk sisanya; ukuran px Figma = sp.
    lineHeight dipasang lewat atribut AppCompat supaya berlaku juga di API 27.

    Catatan: nama bertitik (A.B) otomatis mewarisi A. Gaya tata letak yang tidak boleh mewarisi
    padding atau clickable induknya diberi nama tanpa titik.
-->
<resources>

    <!-- ===== Teks ===== -->
    <style name="Teks">
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="fontFamily">@font/figtree_regular</item>
        <item name="android:textColor">@color/teks_utama</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Judul pembuka K01, 30/34 -->
    <style name="Teks.Hero">
        <item name="android:fontFamily">@font/gabarito_extrabold</item>
        <item name="fontFamily">@font/gabarito_extrabold</item>
        <item name="android:textSize">30sp</item>
        <item name="lineHeight">34sp</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <!-- Judul besar layar (K02, K03), 28/33 -->
    <style name="Teks.JudulBesar">
        <item name="android:fontFamily">@font/gabarito_extrabold</item>
        <item name="fontFamily">@font/gabarito_extrabold</item>
        <item name="android:textSize">28sp</item>
        <item name="lineHeight">33sp</item>
        <item name="android:letterSpacing">-0.028</item>
    </style>

    <!-- Judul app bar dan kartu, 16/19 -->
    <style name="Teks.JudulBar">
        <item name="android:fontFamily">@font/gabarito_extrabold</item>
        <item name="fontFamily">@font/gabarito_extrabold</item>
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">19sp</item>
        <item name="android:letterSpacing">-0.012</item>
    </style>

    <!-- Judul bagian ("Alergi", "Kategori"), 15/18 -->
    <style name="Teks.JudulSeksi">
        <item name="android:fontFamily">@font/gabarito_extrabold</item>
        <item name="fontFamily">@font/gabarito_extrabold</item>
        <item name="android:textSize">15sp</item>
        <item name="lineHeight">18sp</item>
        <item name="android:letterSpacing">-0.013</item>
    </style>

    <!-- Paragraf, 14/22 -->
    <style name="Teks.Isi">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">22sp</item>
        <item name="android:textColor">@color/teks_kuat</item>
    </style>

    <!-- Paragraf kecil (catatan), 12.5/19 -->
    <style name="Teks.IsiKecil">
        <item name="android:textSize">12.5sp</item>
        <item name="lineHeight">19sp</item>
        <item name="android:textColor">@color/teks_kuat</item>
    </style>

    <!-- Teks tebal kecil (sub kartu, tautan), 12.5/17 -->
    <style name="Teks.Sub">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">12.5sp</item>
        <item name="lineHeight">17sp</item>
        <item name="android:textColor">@color/teks_tersier</item>
    </style>

    <!-- Label di atas kolom isian, 12/17 -->
    <style name="Teks.Label">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">17sp</item>
        <item name="android:textColor">@color/teks_kuat</item>
    </style>

    <!-- Subjudul app bar ("Langkah 1 dari 2"), 11/15 -->
    <style name="Teks.Keterangan">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="lineHeight">15sp</item>
        <item name="android:textColor">@color/teks_sekunder</item>
    </style>

    <!-- Teks bantuan di bawah kolom dan catatan kaki, 11.5/16 -->
    <style name="Teks.Bantuan">
        <item name="android:fontFamily">@font/figtree_medium</item>
        <item name="fontFamily">@font/figtree_medium</item>
        <item name="android:textSize">11.5sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:textColor">@color/teks_sekunder</item>
    </style>

    <!-- Lencana kecil ("Masuk sebagai konsumen"), 10.5 bold -->
    <style name="Teks.Lencana">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- Isi kolom isian, 13.5 semibold -->
    <style name="TeksIsian">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">@color/teks_utama</item>
        <item name="android:textColorHint">@color/teks_tersier</item>
        <!-- TextInputEditText membawa letterSpacing 0.03 dari tema Material; Figma 0. -->
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ===== Beranda dan kartu jualan (K07, komponen Kartu flash / Kartu tas) ===== -->
    <!-- Judul Kartu flash, 13.5/17 bold -->
    <style name="Teks.JudulKartuKecil">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">13.5sp</item>
        <item name="lineHeight">17sp</item>
    </style>

    <!-- Judul Kartu tas, 14.5/18 bold -->
    <style name="Teks.JudulKartu">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">14.5sp</item>
        <item name="lineHeight">18sp</item>
    </style>

    <!-- Nama toko di kartu, 11.5/16 medium -->
    <style name="Teks.NamaToko">
        <item name="android:fontFamily">@font/figtree_medium</item>
        <item name="fontFamily">@font/figtree_medium</item>
        <item name="android:textSize">11.5sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:textColor">@color/teks_sekunder</item>
    </style>

    <!-- Harga jual Kartu flash, Gabarito 15/18 hijau -->
    <style name="Teks.Harga">
        <item name="android:fontFamily">@font/gabarito_extrabold</item>
        <item name="fontFamily">@font/gabarito_extrabold</item>
        <item name="android:textSize">15sp</item>
        <item name="lineHeight">18sp</item>
        <item name="android:textColor">@color/teks_merek</item>
    </style>

    <!-- Harga jual Kartu tas, 16/19 -->
    <style name="Teks.Harga.Besar">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">19sp</item>
    </style>

    <!-- Harga normal dicoret (garis coret dipasang di kode), 11/15 -->
    <style name="Teks.HargaCoret">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="lineHeight">15sp</item>
        <item name="android:textColor">@color/teks_coret</item>
    </style>

    <!-- Pil kecil berikon ("48 menit", "20.30 sampai 21.00"), 10.5 bold, padding 10/6 -->
    <style name="Teks.Pil">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- Label ubin kategori, 11/15 semibold -->
    <style name="Teks.Ubin">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="lineHeight">15sp</item>
        <item name="android:textColor">@color/teks_kuat</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <!-- Label Nav bawah, 10/13 bold; warnanya dari selector nav_bawah_warna -->
    <style name="Teks.Nav">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textColor">@color/nav_bawah_warna</item>
    </style>

    <!-- Placeholder kolom cari K07, 13.5 semibold -->
    <style name="Teks.Petunjuk">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">@color/teks_sekunder</item>
    </style>

    <!-- Satu tab Nav bawah, 52dp; nama tanpa titik supaya tidak mewarisi gaya teks. -->
    <style name="TabNav">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="TabNavIkon">
        <item name="android:layout_width">21dp</item>
        <item name="android:layout_height">21dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:contentDescription">@null</item>
    </style>


    <!-- ===== Kolom isian ===== -->
    <!-- Kotak 50dp, radius 14, garis 1dp E2EAE4; fokus berganti hijau. -->
    <style name="IsianBulat" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxStrokeColor">@color/isian_garis</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxBackgroundColor">@color/latar_kartu</item>
        <item name="hintEnabled">false</item>
        <!-- Bantuan dan galat ditulis TextView sendiri di bawah kotak (lihat BantuanIsian),
             karena bawaan TextInputLayout menjorok 14dp, sedangkan Figma rata dengan label. -->
        <item name="helperTextEnabled">false</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="IsianTeks" parent="TeksIsian">
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <!-- ===== Tombol ===== -->
    <style name="Widget.LifeOfFoods.Tombol.Utama" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.LifeOfFoods.Tombol.Garis" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">@color/garis_tegas</item>
        <item name="android:textColor">@color/teks_kuat</item>
    </style>

    <!-- Abu-abu, misalnya "Lewati" di K05 -->
    <style name="Widget.LifeOfFoods.Tombol.Lembut" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="fontFamily">@font/figtree_bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/latar_lembut</item>
        <item name="android:textColor">@color/teks_tersier</item>
    </style>

    <!-- Tautan teks tanpa latar ("Ubah nomor", "Kirim ulang") -->
    <style name="Widget.LifeOfFoods.Tombol.Tautan" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/merek_utama</item>
    </style>

    <!-- Bilah aksi bawah: garis atas, padding 14/20. -->
    <style name="BilahAksi">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/bg_bilah_aksi</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- ===== Chip pilihan K05 (dan nanti K09, K19): tinggi 40, radius 12, garis 1.5 ===== -->
    <style name="Widget.LifeOfFoods.Chip.Pilihan" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_pilihan_latar</item>
        <item name="chipStrokeColor">@color/chip_pilihan_garis</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="textStartPadding">6dp</item>
        <item name="textEndPadding">6dp</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIcon">@drawable/ic_centang</item>
        <item name="checkedIconTint">@color/merek_utama</item>
        <item name="checkedIconSize">14dp</item>
        <item name="iconStartPadding">6dp</item>
        <item name="android:textAppearance">@style/TeksChip</item>
        <item name="android:textColor">@color/chip_pilihan_teks</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="TeksChip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ===== K01 kartu peran: padding 18, jarak 14, radius 20 ===== -->
    <style name="KartuPeran">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">18dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="KartuPeranIkon">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="KartuPeranTeks">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="KartuPeranChevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:src">@drawable/ic_chevron_kanan</item>
    </style>

    <!-- ===== K03 kotak digit OTP: 48x56, jarak 10, radius 14 ===== -->
    <style name="KotakOtp">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/bg_kotak_otp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/teks_utama</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/gabarito_extrabold</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
