<?xml version="1.0" encoding="utf-8"?>
<!--
    Alur mitra M01 sampai M21. Tujuan awal diatur MainActivity: m01_masuk kalau belum ada sesi,
    m05_dashboard kalau sudah. Ganti SegeraFragment dengan fragment sungguhan per layar.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_mitra"
    app:startDestination="@id/m01_masuk">

    <fragment
        android:id="@+id/m01_masuk"
        android:name="id.lifeoffoods.ui.masuk.MasukFragment">
        <argument
            android:name="peran"
            android:defaultValue="partner"
            app:argType="string" />
        <action
            android:id="@+id/ke_verifikasi"
            app:destination="@id/m02_verifikasi" />
    </fragment>

    <fragment
        android:id="@+id/m02_verifikasi"
        android:name="id.lifeoffoods.ui.masuk.VerifikasiOtpFragment" />

    <fragment
        android:id="@+id/m05_dashboard"
        android:name="id.lifeoffoods.ui.SegeraFragment">
        <argument
            android:name="kode_layar"
            android:defaultValue="M05"
            app:argType="string" />
        <argument
            android:name="judul"
            android:defaultValue="Dashboard mitra"
            app:argType="string" />
    </fragment>

    <!-- M11 Pesanan masuk (PRD-10). Tujuan awal mitra selama M05 belum dibuat. -->
    <fragment
        android:id="@+id/m11_pesanan"
        android:name="id.lifeoffoods.ui.mitra.PesananMasukFragment" />

    <!-- M12 Cocokkan kode (PRD-11). -->
    <fragment
        android:id="@+id/m12_cocokkan"
        android:name="id.lifeoffoods.ui.mitra.CocokkanKodeFragment" />

    <!-- M10 Kelola jualan dan M17 Kelola menu satuan (PRD-09); argumen tipe memilih segmen. -->
    <fragment
        android:id="@+id/m10_kelola"
        android:name="id.lifeoffoods.ui.mitra.KelolaJualanFragment">
        <argument
            android:name="tipe"
            android:defaultValue="surprise_bag"
            app:argType="string" />
    </fragment>

    <!-- M09 Pasang tas (PRD-09). -->
    <fragment
        android:id="@+id/m09_pasang_tas"
        android:name="id.lifeoffoods.ui.mitra.PasangTasFragment" />

    <!-- M16 Pasang menu satuan (PRD-09). -->
    <fragment
        android:id="@+id/m16_pasang_menu"
        android:name="id.lifeoffoods.ui.mitra.PasangMenuFragment" />
</navigation>
