<?xml version="1.0" encoding="utf-8"?>
<!-- K01 Pilih peran (Figma 17:2). Slot foto Figma diisi dua foto: konsumen dan mitra. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradien_awal"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/isi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- Logo resmi (vektor), bukan teks + font, supaya tulisannya sama persis dengan Figma. -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_lengkap_putih" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!-- Dua foto bertumpuk: konsumen (besar) dan mitra (kecil), berlabel sesuai kartu di bawah.
             Hiasan saja, jadi disembunyikan dari pembaca layar. Sumber foto: docs/aset/SUMBER-foto-onboarding.md -->
        <FrameLayout
            android:layout_width="264dp"
            android:layout_height="208dp"
            android:layout_gravity="center_horizontal"
            android:clipChildren="false"
            android:importantForAccessibility="noHideDescendants">

            <com.google.android.material.imageview.ShapeableImageView
                style="@style/FotoPeran"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:src="@drawable/foto_peran_konsumen" />

            <com.google.android.material.imageview.ShapeableImageView
                style="@style/FotoPeran"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_marginStart="132dp"
                android:layout_marginTop="72dp"
                android:src="@drawable/foto_peran_mitra" />

            <TextView
                style="@style/LabelFotoPeran"
                android:layout_marginStart="12dp"
                android:layout_marginTop="148dp"
                android:background="@drawable/bg_pil_putih"
                android:text="@string/k01_foto_konsumen" />

            <TextView
                style="@style/LabelFotoPeran"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_pil_lime"
                android:text="@string/k01_foto_mitra" />
        </FrameLayout>

        <TextView
            style="@style/Teks.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/k01_judul"
            android:textColor="@color/teks_di_gelap" />

        <TextView
            style="@style/Teks.Isi"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/k01_sub"
            android:textColor="@color/teks_di_gelap" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="40dp" />

        <LinearLayout
            android:id="@+id/kartu_konsumen"
            style="@style/KartuPeran"
            android:background="@drawable/bg_kartu_putih">

            <ImageView
                style="@style/KartuPeranIkon"
                android:background="@drawable/bg_ikon_mint"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_paket"
                app:tint="@color/merek_utama" />

            <LinearLayout style="@style/KartuPeranTeks">

                <TextView
                    style="@style/Teks.JudulBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/k01_konsumen_judul" />

                <TextView
                    style="@style/Teks.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/k01_konsumen_sub" />
            </LinearLayout>

            <ImageView
                style="@style/KartuPeranChevron"
                android:importantForAccessibility="no"
                app:tint="@color/teks_utama" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/kartu_mitra"
            style="@style/KartuPeran"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_kartu_transparan">

            <ImageView
                style="@style/KartuPeranIkon"
                android:background="@drawable/bg_ikon_transparan"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_toko"
                app:tint="@color/merek_lime" />

            <LinearLayout style="@style/KartuPeranTeks">

                <TextView
                    style="@style/Teks.JudulBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/k01_mitra_judul"
                    android:textColor="@color/teks_di_gelap" />

                <TextView
                    style="@style/Teks.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/k01_mitra_sub"
                    android:textColor="@color/teks_di_gelap" />
            </LinearLayout>

            <ImageView
                style="@style/KartuPeranChevron"
                android:importantForAccessibility="no"
                app:tint="@color/teks_di_gelap" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Teks.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/k01_belum_punya_akun"
                android:textColor="@color/teks_di_gelap" />

            <TextView
                android:id="@+id/tautan_daftar"
                style="@style/Teks.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/k01_daftar"
                android:textColor="@color/merek_lime" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
