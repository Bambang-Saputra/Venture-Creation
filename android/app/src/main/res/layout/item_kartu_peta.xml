<?xml version="1.0" encoding="utf-8"?>
<!--
    Kartu jualan K08 (Figma kartu di bawah peta): foto, "380 m, tutup 21.00", judul, harga dan harga
    coret, lalu tombol rute yang membuka aplikasi peta (geo:).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_kartu_20"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_slot_foto">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_gambar"
            app:tint="@color/ikon_redup" />

        <ImageView
            android:id="@+id/foto_jualan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/meta"
            style="@style/Teks.Keterangan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="380 m, tutup 21.00" />

        <TextView
            android:id="@+id/judul"
            style="@style/Teks.JudulKartu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/teks_utama"
            tools:text="Tas Pastry Sore" />

        <TextView
            android:id="@+id/toko"
            style="@style/Teks.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/teks_sekunder"
            tools:text="Kopi Kalyan SCBD" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/harga"
                style="@style/Teks.Harga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Rp18.000" />

            <TextView
                android:id="@+id/harga_normal"
                style="@style/Teks.HargaCoret"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                tools:text="Rp55.000" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/tombol_rute"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_tombol_ikon"
        android:src="@drawable/ic_pin_lokasi"
        app:tint="@color/teks_merek"
        tools:contentDescription="Rute ke Kopi Kalyan" />
</LinearLayout>
