<?xml version="1.0" encoding="utf-8"?>
<!--
    K12 Ringkasan tas kejutan dan K13 Ringkasan menu satuan (Figma "Layar aplikasi", PRD-06).
    Satu layout: K13 menampilkan stepper di baris item dan judul "Item (n)".

    Beda dengan Figma, disengaja karena lingkup pilot (ADR-0004, PRD-06 "Di luar lingkup"):
    - Tab Kurir tampil tapi nonaktif; pesanan selalu diambil sendiri.
    - Tautan "Ubah" lokasi tidak ada, karena lokasi ambil selalu alamat toko.
    - Cara bayar hanya tunai dan QRIS toko (cash, qris_static). GoPay dan kartu tidak ada.
    - Kotak peringatan alergi ditambahkan sebelum tombol (PRD-06 kriteria 2).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <include
        android:id="@+id/kepala"
        layout="@layout/include_kepala" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/rincian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="4dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp"
                android:visibility="invisible"
                tools:visibility="visible">

                <!-- Ambil sendiri / Kurir -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_kartu_jualan"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <LinearLayout
                        android:id="@+id/tab_ambil"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_kotak_merek_12"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_tas"
                            app:tint="@color/merek_utama" />

                        <TextView
                            style="@style/Teks.Segmen"
                            android:text="@string/k12_ambil_sendiri"
                            android:textColor="@color/teks_merek" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tab_kurir"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:alpha="0.55"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_truk"
                            app:tint="@color/teks_tersier" />

                        <TextView
                            style="@style/Teks.Segmen"
                            android:text="@string/k12_kurir"
                            android:textColor="@color/teks_tersier" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Lokasi dan jam ambil -->
                <LinearLayout style="@style/KotakDetail">

                    <TextView
                        style="@style/Teks.Kapital"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/k12_lokasi_ambil" />

                    <TextView
                        android:id="@+id/alamat"
                        style="@style/Teks.Isi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/teks_utama"
                        tools:text="Jl. Jend. Sudirman Kav 52, Lobi Utama, Jakarta Selatan" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/garis_halus" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_jam"
                            app:tint="@color/teks_kuat" />

                        <TextView
                            style="@style/Teks.Isi"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/k12_jam_ambil" />

                        <TextView
                            android:id="@+id/jam_ambil"
                            style="@style/Teks.Isi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/teks_utama"
                            tools:text="20.30 sampai 21.00" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Pesanan / Item (n) -->
                <LinearLayout style="@style/KotakDetail">

                    <TextView
                        android:id="@+id/judul_item"
                        style="@style/Teks.JudulKotak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/k12_pesanan" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/daftar_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="1"
                        tools:listitem="@layout/item_baris_ringkasan" />
                </LinearLayout>

                <!-- Peringatan alergi: sebelum tombol "Buat pesanan", tidak memblokir. -->
                <LinearLayout
                    android:id="@+id/peringatan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_kotak_peringatan"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_peringatan"
                        app:tint="@color/tanda_proses_teks" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Teks.JudulKartuKecil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/k12_peringatan_judul"
                            android:textColor="@color/tanda_proses_teks" />

                        <TextView
                            android:id="@+id/isi_peringatan"
                            style="@style/Teks.Catatan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/tanda_proses_teks"
                            tools:text="Tas Pastry Sore: mungkin mengandung kacang tanah" />

                        <TextView
                            style="@style/Teks.Bantuan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/k12_peringatan_catatan"
                            android:textColor="@color/tanda_proses_teks" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Catatan untuk mitra -->
                <LinearLayout style="@style/KotakDetail">

                    <TextView
                        style="@style/Teks.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/catatan"
                        android:text="@string/k12_catatan" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/IsianBulat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:counterEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/catatan"
                            style="@style/IsianTeks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/k12_catatan_petunjuk"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="300"
                            android:maxLines="4"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/Teks.Bantuan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/k12_catatan_bantuan" />
                </LinearLayout>

                <!-- Cara bayar -->
                <LinearLayout style="@style/KotakDetail">

                    <TextView
                        style="@style/Teks.JudulKotak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/k12_cara_bayar" />

                    <LinearLayout
                        android:id="@+id/baris_tunai"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_tunai"
                            style="@style/Teks.Isi"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:minHeight="0dp"
                            android:paddingStart="8dp"
                            android:text="@string/k12_tunai"
                            android:textColor="@color/teks_utama"
                            app:buttonTint="@color/merek_utama" />

                        <TextView
                            style="@style/Teks.Keterangan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/k12_tunai_ket" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/baris_qris"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_qris"
                            style="@style/Teks.Isi"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="0dp"
                            android:paddingStart="8dp"
                            android:text="@string/k12_qris"
                            android:textColor="@color/teks_utama"
                            app:buttonTint="@color/merek_utama" />

                        <TextView
                            style="@style/Teks.Keterangan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/k12_qris_ket" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/keadaan"
                layout="@layout/include_keadaan_muat" />
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bilah_aksi"
        style="@style/BilahAksi"
        android:gravity="center_vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="75dp"
            android:orientation="vertical">

            <TextView
                style="@style/Teks.Keterangan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/k12_total_bayar" />

            <TextView
                android:id="@+id/total"
                style="@style/Teks.Harga.Total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/teks_utama"
                tools:text="Rp18.000" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombol_buat"
            style="@style/Widget.LifeOfFoods.Tombol.Utama"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/k12_buat_pesanan" />
    </LinearLayout>
</LinearLayout>
