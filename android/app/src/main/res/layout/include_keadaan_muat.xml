<?xml version="1.0" encoding="utf-8"?>
<!-- Keadaan memuat atau gagal untuk layar detail: progres, atau pesan dengan tombol Coba lagi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ProgressBar
        android:id="@+id/progres"
        style="?android:attr/progressBarStyle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminateTint="@color/merek_utama" />

    <LinearLayout
        android:id="@+id/gagal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Teks.JudulKartu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_gagal_judul" />

        <TextView
            android:id="@+id/gagal_isi"
            style="@style/Teks.IsiKecil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/k07_gagal_isi" />

        <Button
            android:id="@+id/tombol_coba_lagi"
            style="@style/Widget.LifeOfFoods.Tombol.Lembut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/coba_lagi" />
    </LinearLayout>
</LinearLayout>
