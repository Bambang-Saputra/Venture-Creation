<?xml version="1.0" encoding="utf-8"?>
<!--
    K11 Detail menu satuan (Figma 25:349): semua menu satuan satu toko, dipilih dengan stepper.
    API belum punya judul atau deskripsi untuk kumpulan menu, jadi judulnya memakai nama toko.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/gulir"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:background="@color/latar_lembut">

                    <include
                        layout="@layout/include_isi_slot_foto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/rincian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="40dp"
                    android:visibility="invisible"
                    tools:visibility="visible">

                    <!-- Mitra -->
                    <LinearLayout style="@style/KotakDetail">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_kotak_merek_12">

                                <ImageView
                                    android:id="@+id/ikon_kategori"
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_toko"
                                    app:tint="@color/merek_utama" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/nama_toko"
                                    style="@style/Teks.JudulToko"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    tools:text="Kopi Kalyan" />

                                <TextView
                                    android:id="@+id/alamat"
                                    style="@style/Teks.NamaToko"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    tools:text="Jl. Jend. Sudirman Kav 52, Lobi Utama, Jakarta Selatan" />

                                <!-- PRD-05 kriteria 8: intent geo: tanpa API key. -->
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/tombol_maps"
                                    style="@style/Widget.LifeOfFoods.Tombol.Tautan"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minHeight="40dp"
                                    android:text="@string/k10_buka_maps"
                                    android:visibility="gone"
                                    app:icon="@drawable/ic_pin_lokasi"
                                    app:iconPadding="6dp"
                                    app:iconSize="15dp"
                                    app:iconTint="@color/teks_merek"
                                    tools:visibility="visible" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp" />
                    </LinearLayout>

                    <!-- Judul -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:id="@+id/chip_jenis"
                            style="@style/Teks.Pil"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pil_isian"
                            android:text="@string/k11_menu_satuan"
                            android:textColor="@color/teks_kuat" />

                        <TextView
                            android:id="@+id/judul"
                            style="@style/Teks.JudulDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            tools:text="Menu sore Kopi Kalyan" />

                        <TextView
                            style="@style/Teks.Isi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/k11_keterangan" />
                    </LinearLayout>

                    <!-- Pilih menu -->
                    <LinearLayout style="@style/KotakDetail">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Teks.JudulKotak"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/k11_pilih_menu" />

                            <TextView
                                style="@style/Teks.Keterangan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/k11_stok_hari_ini" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/daftar_menu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_baris_menu" />
                    </LinearLayout>

                    <include layout="@layout/include_catatan_surplus" />
                </LinearLayout>

                <include
                    android:id="@+id/keadaan"
                    layout="@layout/include_keadaan_muat" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/tombol_atas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/tombol_kembali"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tombol_foto"
                android:contentDescription="@string/kembali"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_panah_kiri"
                app:tint="@color/teks_utama" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/tombol_favorit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tombol_foto"
                android:contentDescription="@string/favorit_tambah"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hati"
                android:visibility="gone"
                app:tint="@color/merek_utama"
                tools:visibility="visible" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bilah_aksi"
        style="@style/BilahAksi"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="75dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/jumlah_ringkas"
                style="@style/Teks.Keterangan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2 item" />

            <TextView
                android:id="@+id/total"
                style="@style/Teks.Harga.Total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                tools:text="Rp18.000" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombol_lanjut"
            style="@style/Widget.LifeOfFoods.Tombol.Utama"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/k11_lanjut"
            app:icon="@drawable/ic_chevron_kanan"
            app:iconGravity="textEnd"
            app:iconSize="17dp" />
    </LinearLayout>
</LinearLayout>
