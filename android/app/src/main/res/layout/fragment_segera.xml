<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/kode_layar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ikon_mint"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="@color/tanda_hemat_teks"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/judul_layar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/teks_utama"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/segera_keterangan"
        android:textColor="@color/teks_sekunder" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tombol_kembali"
        style="@style/Widget.LifeOfFoods.Tombol.Garis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/segera_kembali" />
</LinearLayout>
