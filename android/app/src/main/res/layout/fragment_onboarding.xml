<?xml version="1.0" encoding="utf-8"?>
<!--
    K06 Onboarding (Figma "K06 · Onboarding"). Tampil sekali sesudah K05, sebelum beranda. Tiga
    halaman yang bisa digeser; Lewati dan halaman terakhir membuka K07.

    Figma hanya menggambar halaman pertama (titik indikator menunjukkan tiga). Halaman 2 dan 3
    memakai pola yang sama, isinya dari alur pilot: peringatan alergi dan bayar di tempat.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_kartu"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/latar_halaman">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/halaman"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="128dp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bawah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/titik"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/titik_1"
                android:layout_width="22dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_titik_aktif" />

            <View
                android:id="@+id/titik_2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_titik_pasif" />

            <View
                android:id="@+id/titik_3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_titik_pasif" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tombol_lewati"
                style="@style/Widget.LifeOfFoods.Tombol.Lembut"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/k06_lewati" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tombol_lanjut"
                style="@style/Widget.LifeOfFoods.Tombol.Utama"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="2.4"
                android:text="@string/k06_lanjut" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
