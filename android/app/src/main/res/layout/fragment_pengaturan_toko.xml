<?xml version="1.0" encoding="utf-8"?>
<!--
    M15 Pengaturan toko dan kasir (Figma "M15 · Pengaturan toko"). Hanya pemilik. Daftar akun
    kasir, undang kasir lewat WhatsApp, dan keterangan batas akses kasir.

    Beda dengan Figma, disengaja: kartu "Pengingat" (tiga sakelar) dan kartu "Toko" (lokasi,
    rekening pencairan, dokumen verifikasi) belum ditampilkan, karena kolomnya belum ada di skema
    dan pencairan masih nonaktif selama pilot (kontrak API bagian 12). Sakelar yang tidak
    menyimpan apa pun hanya akan menyesatkan mitra.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <include
        android:id="@+id/kepala"
        layout="@layout/include_kepala" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/gulir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/isi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_kartu_20"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Teks.JudulKartu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/m15_akun_kasir"
                        android:textColor="@color/teks_utama" />

                    <LinearLayout
                        android:id="@+id/daftar_anggota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombol_undang"
                        style="@style/Widget.LifeOfFoods.Tombol.Tautan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:minHeight="48dp"
                        android:paddingStart="0dp"
                        android:text="@string/m15_undang"
                        app:icon="@drawable/ic_tambah"
                        app:iconSize="18dp"
                        app:iconTint="@color/teks_merek" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_kotak_lembut_16"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="2dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_gembok"
                            app:tint="@color/teks_sekunder" />

                        <TextView
                            style="@style/Teks.Isi"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/m15_info_kasir"
                            android:textColor="@color/teks_sekunder" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/keadaan"
            layout="@layout/include_keadaan_muat" />
    </FrameLayout>
</LinearLayout>
