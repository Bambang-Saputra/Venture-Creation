<?xml version="1.0" encoding="utf-8"?>
<!--
    Komponen "Nav bawah" konsumen: Beranda, Favorit, Pesanan, Profil (ikon 21, label 10 bold).
    Tinggi Figma 87 termasuk indikator home iOS 26, jadi di sini padding bawah 8.
    Tab aktif ditandai setSelected(true) pada tab_xxx; ikon dan label ikut lewat duplicateParentState.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_garis_atas"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/tab_beranda"
        style="@style/TabNav"
        android:contentDescription="@string/nav_beranda">

        <ImageView
            style="@style/TabNavIkon"
            android:contentDescription="@null"
            android:src="@drawable/ic_rumah"
            app:tint="@color/nav_bawah_warna" />

        <TextView
            style="@style/Teks.Nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:text="@string/nav_beranda" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_favorit"
        style="@style/TabNav"
        android:contentDescription="@string/nav_favorit">

        <ImageView
            style="@style/TabNavIkon"
            android:contentDescription="@null"
            android:src="@drawable/ic_hati"
            app:tint="@color/nav_bawah_warna" />

        <TextView
            style="@style/Teks.Nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:text="@string/nav_favorit" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_pesanan"
        style="@style/TabNav"
        android:contentDescription="@string/nav_pesanan">

        <ImageView
            style="@style/TabNavIkon"
            android:contentDescription="@null"
            android:src="@drawable/ic_tas"
            app:tint="@color/nav_bawah_warna" />

        <TextView
            style="@style/Teks.Nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:text="@string/nav_pesanan" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_profil"
        style="@style/TabNav"
        android:contentDescription="@string/nav_profil">

        <ImageView
            style="@style/TabNavIkon"
            android:contentDescription="@null"
            android:src="@drawable/ic_pengguna"
            app:tint="@color/nav_bawah_warna" />

        <TextView
            style="@style/Teks.Nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:text="@string/nav_profil" />
    </LinearLayout>
</LinearLayout>
