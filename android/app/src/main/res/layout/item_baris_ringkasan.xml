<?xml version="1.0" encoding="utf-8"?>
<!--
    Satu baris di kotak "Pesanan" K12 / "Item (n)" K13. K12: slot foto, judul, "Tas kejutan · isi
    dipilih mitra", "1 × Rp18.000". K13: ikon tas, judul, harga hijau + harga normal dicoret, stepper.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_kotak_lembut_12">

        <ImageView
            android:id="@+id/ikon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_gambar"
            app:tint="@color/ikon_redup" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/judul"
            style="@style/Teks.JudulKartuKecil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Tas Pastry Sore" />

        <TextView
            android:id="@+id/keterangan"
            style="@style/Teks.Keterangan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/k12_isi_tas" />

        <LinearLayout
            android:id="@+id/baris_harga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:baselineAligned="true"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/harga"
                style="@style/Teks.Harga.Kecil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Rp9.000" />

            <TextView
                android:id="@+id/harga_normal"
                style="@style/Teks.HargaCoret"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:visibility="gone"
                tools:text="Rp28.000"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/jumlah_harga"
        style="@style/Teks.Butir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="1 × Rp18.000" />

    <!-- Tampil hanya di K13; diatur dari kode (atribut visibility di tag include diabaikan). -->
    <include
        android:id="@+id/stepper"
        layout="@layout/include_stepper" />
</LinearLayout>
