<?xml version="1.0" encoding="utf-8"?>
<!--
    K12 Ringkasan tas kejutan (59:1212) dan K13 Ringkasan menu satuan (27:469).
    Belum ada: pilihan Kurir (API hanya ambil sendiri), voucher (WON'T), dan GoPay/kartu.
    Cara bayar mengikuti API: tunai atau QRIS statis, keduanya dibayar di tempat (ADR-0004).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <include
        android:id="@+id/kepala"
        layout="@layout/include_kepala" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rincian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="2dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp"
                android:visibility="invisible"
                tools:visibility="visible">

                <!-- Lokasi ambil -->
                <LinearLayout style="@style/KotakDetail">

                    <TextView
                        style="@style/Teks.Keterangan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="@string/k12_lokasi_ambil"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/nama_toko"
                        style="@style/Teks.JudulKartuKecil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        tools:text="Kopi Kalyan" />

                    <TextView
                        android:id="@+id/alamat"
                        style="@style/Teks.Butir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="Jl. Jend. Sudirman Kav 52, Lobi Utama, Jakarta Selatan" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/garis_halus" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_jam"
                            app:tint="@color/teks_kuat" />

                        <TextView
                            style="@style/Teks.Butir"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/k12_jam_ambil"
                            android:textColor="@color/teks_kuat" />

                        <TextView
                            android:id="@+id/jam_ambil"
                            style="@style/Teks.Butir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="20.30 sampai 21.00" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Item -->
                <LinearLayout style="@style/KotakDetail">

                    <TextView
                        android:id="@+id/judul_item"
                        style="@style/Teks.JudulKotak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Pesanan" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/daftar_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="1"
                        tools:listitem="@layout/item_ringkasan_tas" />

                    <TextView
                        android:id="@+id/pesan_gagal"
                        style="@style/Teks.Catatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/tanda_bahaya_teks"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Peringatan alergi dari pratinjau: wajib tampil sebelum "Buat pesanan". -->
                <LinearLayout
                    android:id="@+id/peringatan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_kotak_peringatan"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_peringatan"
                        app:tint="@color/tanda_proses_teks" />

                    <TextView
                        android:id="@+id/peringatan_teks"
                        style="@style/Teks.Catatan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/tanda_proses_teks" />
                </LinearLayout>

                <!-- Catatan untuk mitra -->
                <LinearLayout style="@style/KotakDetail">

                    <TextView
                        style="@style/Teks.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/catatan"
                        android:text="@string/k12_catatan" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/isian_catatan"
                        style="@style/IsianBulat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:counterMaxLength="300">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/catatan"
                            style="@style/IsianTeks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/k12_catatan_contoh"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="300"
                            android:minHeight="50dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/Teks.Bantuan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/k12_catatan_bantuan" />
                </LinearLayout>

                <!-- Cara bayar -->
                <LinearLayout style="@style/KotakDetail">

                    <TextView
                        style="@style/Teks.JudulKotak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/k12_cara_bayar" />

                    <LinearLayout
                        android:id="@+id/bayar_tunai"
                        style="@style/BarisRadio">

                        <RadioButton
                            android:id="@+id/radio_tunai"
                            style="@style/Radio" />

                        <TextView
                            style="@style/Teks.Butir"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/k12_tunai" />

                        <TextView
                            style="@style/Teks.NamaToko"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/k12_bayar_saat_ambil" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bayar_qris"
                        style="@style/BarisRadio">

                        <RadioButton
                            android:id="@+id/radio_qris"
                            style="@style/Radio" />

                        <TextView
                            style="@style/Teks.Butir"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/k12_qris" />

                        <TextView
                            style="@style/Teks.NamaToko"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/k12_scan_di_kasir" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Rincian biaya -->
                <LinearLayout style="@style/KotakDetail">

                    <TextView
                        style="@style/Teks.JudulKotak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/k12_rincian_biaya" />

                    <include
                        android:id="@+id/biaya_subtotal"
                        layout="@layout/include_baris_biaya" />

                    <include
                        android:id="@+id/biaya_layanan"
                        layout="@layout/include_baris_biaya" />

                    <include
                        android:id="@+id/biaya_diskon"
                        layout="@layout/include_baris_biaya" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/garis_halus" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Teks.JudulKartu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/k12_total" />

                        <TextView
                            android:id="@+id/total_rincian"
                            style="@style/Teks.Harga.Total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Rp18.000" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/keadaan"
                layout="@layout/include_keadaan_muat" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bilah_aksi"
        style="@style/BilahAksi"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="68dp"
            android:orientation="vertical">

            <TextView
                style="@style/Teks.Keterangan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/k12_total_bayar" />

            <TextView
                android:id="@+id/total"
                style="@style/Teks.Harga.Total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/teks_utama"
                tools:text="Rp18.000" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombol_buat"
            style="@style/Widget.LifeOfFoods.Tombol.Utama"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/k12_buat_pesanan" />
    </LinearLayout>
</LinearLayout>
