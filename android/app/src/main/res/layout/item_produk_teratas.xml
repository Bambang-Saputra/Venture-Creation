<?xml version="1.0" encoding="utf-8"?>
<!-- Satu baris "Produk paling sering sisa" M07: nama, jumlah dan nilai, batang relatif. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:importantForAccessibility="yes"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nama"
            style="@style/Teks.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/teks_utama"
            android:textSize="13.5sp"
            tools:text="Croissant mentega" />

        <TextView
            android:id="@+id/ket"
            style="@style/Teks.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/teks_sekunder"
            android:textSize="12sp"
            tools:text="34 item · Rp952.000" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_batang_jalur"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:weightSum="1">

        <View
            android:id="@+id/isi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_batang_isi" />
    </LinearLayout>
</LinearLayout>
