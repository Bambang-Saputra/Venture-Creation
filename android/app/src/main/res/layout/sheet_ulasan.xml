<?xml version="1.0" encoding="utf-8"?>
<!--
    Lembar "Beri ulasan" dari K15 (POST /orders/{id}/review). Tidak ada di Figma; memakai gaya
    kotak dan tombol yang sama dengan layar lain. Lima bintang 40dp (target sentuh 48dp), komentar
    opsional maks 500, tombol Kirim mati sampai ada bintang yang dipilih.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        style="@style/Teks.JudulSeksi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/k15_ulasan_judul" />

    <TextView
        android:id="@+id/toko"
        style="@style/Teks.NamaToko"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="Kopi Kalyan" />

    <LinearLayout
        android:id="@+id/bintang"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/arti"
        style="@style/Teks.Keterangan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="@string/k15_ulasan_pilih"
        android:textColor="@color/teks_kuat" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/isian_komentar"
        style="@style/IsianBulat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:counterEnabled="true"
        app:counterMaxLength="500">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/komentar"
            style="@style/IsianTeks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/k15_ulasan_komentar"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:maxLines="4" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/galat"
        style="@style/Teks.Keterangan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/tanda_bahaya_teks"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tombol_kirim"
        style="@style/Widget.LifeOfFoods.Tombol.Utama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:text="@string/k15_ulasan_kirim" />
</LinearLayout>
