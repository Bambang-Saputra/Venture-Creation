<?xml version="1.0" encoding="utf-8"?>
<!-- K03 Verifikasi OTP (Figma 55:966) dan M02 (65:1705). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_kartu"
    android:orientation="vertical">

    <include
        android:id="@+id/kepala"
        layout="@layout/include_kepala" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/Teks.JudulBesar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/k03_judul" />

            <TextView
                android:id="@+id/keterangan"
                style="@style/Teks.Isi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp" />

            <Button
                android:id="@+id/tombol_ubah_nomor"
                style="@style/Widget.LifeOfFoods.Tombol.Tautan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/k03_ubah_nomor" />

            <!-- Tambahan di luar Figma: kode pilot tampil selama PILOT_MODE=true. -->
            <LinearLayout
                android:id="@+id/spanduk_uji"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_spanduk_uji"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    style="@style/Teks.Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_bold"
                    android:text="@string/k03_mode_uji_judul"
                    android:textColor="@color/tanda_proses_teks" />

                <TextView
                    android:id="@+id/teks_uji"
                    style="@style/Teks.IsiKecil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/tanda_proses_teks" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <!-- Menerima ketikan. Transparan di atas kotak supaya tetap bisa disentuh dan dibaca TalkBack. -->
                <EditText
                    android:id="@+id/kode"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:autofillHints="smsOTPCode"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:hint="@string/k03_hint_kode"
                    android:importantForAutofill="yes"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textColor="@android:color/transparent"
                    android:textColorHint="@android:color/transparent" />

                <LinearLayout
                    android:id="@+id/baris_kotak"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/kotak1" style="@style/KotakOtp" />
                    <TextView android:id="@+id/kotak2" style="@style/KotakOtp" />
                    <TextView android:id="@+id/kotak3" style="@style/KotakOtp" />
                    <TextView android:id="@+id/kotak4" style="@style/KotakOtp" />
                    <TextView android:id="@+id/kotak5" style="@style/KotakOtp" />
                    <TextView android:id="@+id/kotak6" style="@style/KotakOtp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/galat_kode"
                style="@style/Teks.Bantuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/tanda_bahaya_teks"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Teks.IsiKecil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/k03_tidak_menerima"
                    android:textColor="@color/teks_sekunder" />

                <Button
                    android:id="@+id/tombol_kirim_ulang"
                    style="@style/Widget.LifeOfFoods.Tombol.Tautan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/tautan_kirim_ulang" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="32dp" />

            <TextView
                style="@style/Teks.Bantuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_catatan_isian"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:text="@string/k03_peringatan"
                android:textColor="@color/teks_kuat"
                app:drawableStartCompat="@drawable/ic_gembok"
                app:drawableTint="@color/teks_kuat" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bilah_aksi"
        style="@style/BilahAksi">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombol_verifikasi"
            style="@style/Widget.LifeOfFoods.Tombol.Utama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/k03_verifikasi" />
    </LinearLayout>
</LinearLayout>
