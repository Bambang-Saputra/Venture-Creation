<?xml version="1.0" encoding="utf-8"?>
<!--
    K10 Detail tas kejutan (Figma 57:1068). Foto mengisi sampai ke balik status bar; tombol kembali
    dan favorit diberi jarak aman oleh SisiAman. Chip rating "4,8 (180)" belum ada karena API
    belum punya ulasan.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/gulir"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/foto"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="@color/latar_lembut">

                    <include
                        layout="@layout/include_isi_slot_foto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center" />

                    <ImageView
                        android:id="@+id/foto_jualan"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/rincian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="40dp"
                    android:visibility="invisible"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/chip_jenis"
                        style="@style/Teks.Pil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pil_lime"
                        android:text="@string/k10_tas_kejutan"
                        android:textColor="@color/teks_utama" />

                    <TextView
                        android:id="@+id/judul"
                        style="@style/Teks.JudulDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        tools:text="Tas Pastry Sore" />

                    <TextView
                        android:id="@+id/meta"
                        style="@style/Teks.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        tools:text="Kopi Kalyan · 380 m · tutup 21.00" />

                    <!-- PRD-05 kriteria 8: intent geo: dengan koordinat toko, tanpa API key. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombol_maps"
                        style="@style/Widget.LifeOfFoods.Tombol.Tautan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/k10_buka_maps"
                        android:visibility="gone"
                        app:icon="@drawable/ic_pin_lokasi"
                        app:iconPadding="6dp"
                        app:iconSize="15dp"
                        app:iconTint="@color/teks_merek"
                        tools:visibility="visible" />

                    <!-- Harga -->
                    <LinearLayout
                        style="@style/KotakDetail"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Teks.Keterangan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/k10_harga_per_tas" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:baselineAligned="true"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/harga"
                                    style="@style/Teks.Harga.Detail"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="Rp18.000" />

                                <TextView
                                    android:id="@+id/nilai"
                                    style="@style/Teks.HargaCoret"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    tools:text="Nilai Rp55.000" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/hemat"
                            style="@style/Teks.Pil"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pil_merek"
                            android:textColor="@color/teks_merek_gelap"
                            tools:text="Hemat 67%" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tautan_menu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tautan_menu_teks"
                            style="@style/Teks.Tautan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Mau pilih sendiri? Lihat menu satuan Kopi Kalyan" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_kanan"
                            app:tint="@color/teks_merek" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp" />

                    <!-- Kandungan dan label -->
                    <LinearLayout style="@style/KotakDetail">

                        <TextView
                            style="@style/Teks.JudulKotak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/k10_kandungan" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp" />

                        <TextView
                            android:id="@+id/bahan"
                            style="@style/Teks.Deskripsi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/peringatan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_kotak_peringatan"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_peringatan"
                                app:tint="@color/tanda_proses_teks" />

                            <TextView
                                android:id="@+id/peringatan_teks"
                                style="@style/Teks.Catatan"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:textColor="@color/tanda_proses_teks" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Perkiraan isi -->
                    <LinearLayout
                        android:id="@+id/kotak_isi"
                        style="@style/KotakDetail">

                        <TextView
                            style="@style/Teks.JudulKotak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/k10_perkiraan_isi" />

                        <TextView
                            android:id="@+id/deskripsi"
                            style="@style/Teks.Deskripsi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />

                        <LinearLayout
                            android:id="@+id/daftar_isi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <include layout="@layout/include_catatan_surplus" />
                </LinearLayout>

                <include
                    android:id="@+id/keadaan"
                    layout="@layout/include_keadaan_muat" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Tombol di atas foto, tetap di tempat saat digulir. -->
        <LinearLayout
            android:id="@+id/tombol_atas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/tombol_kembali"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tombol_foto"
                android:contentDescription="@string/kembali"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_panah_kiri"
                app:tint="@color/teks_utama" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/tombol_favorit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tombol_foto"
                android:contentDescription="@string/favorit_tambah"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hati"
                android:visibility="gone"
                app:tint="@color/merek_utama"
                tools:visibility="visible" />
        </LinearLayout>
    </FrameLayout>

    <!-- Aksi: total, stepper, Pesan -->
    <LinearLayout
        android:id="@+id/bilah_aksi"
        style="@style/BilahAksi"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="75dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/jumlah_ringkas"
                style="@style/Teks.Keterangan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="1 tas" />

            <TextView
                android:id="@+id/total"
                style="@style/Teks.Harga.Total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                tools:text="Rp18.000" />
        </LinearLayout>

        <include
            android:id="@+id/stepper"
            layout="@layout/include_stepper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombol_pesan"
            style="@style/Widget.LifeOfFoods.Tombol.Utama"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/k10_pesan" />
    </LinearLayout>
</LinearLayout>
