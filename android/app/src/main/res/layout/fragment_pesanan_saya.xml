<?xml version="1.0" encoding="utf-8"?>
<!--
    K15 Pesanan saya (Figma 29:583, PRD-08). Header putih berisi judul dan tab Aktif / Riwayat,
    daftar Kartu pesanan, Nav bawah dengan tab Pesanan terpilih.
    Beda dengan Figma, disengaja: label status mengikuti PRD-08 kriteria 2 ("Menunggu diambil",
    "Selesai", "Dibatalkan", "Tidak diambil"); pil "Diproses" tidak ada karena API tidak punya
    status itu.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_garis_bawah"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp">

        <TextView
            style="@style/Teks.JudulHalaman"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/k15_judul" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_aktif"
                style="@style/Teks.JudulKotak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tab_aktif"
                android:minHeight="32dp"
                android:paddingBottom="12dp"
                android:text="@string/k15_tab_aktif"
                android:textColor="@color/teks_merek" />

            <TextView
                android:id="@+id/tab_riwayat"
                style="@style/Teks.JudulKotak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:minHeight="32dp"
                android:paddingBottom="12dp"
                android:text="@string/k15_tab_riwayat"
                android:textColor="@color/teks_sekunder" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/daftar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="4"
            tools:listitem="@layout/item_kartu_pesanan" />

        <!-- Kosong: pesan dan tombol ke Beranda (tab Aktif) atau pesan saja (tab Riwayat). -->
        <LinearLayout
            android:id="@+id/kosong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tas"
                app:tint="@color/ikon_redup" />

            <TextView
                android:id="@+id/kosong_judul"
                style="@style/Teks.JudulKartu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                tools:text="Belum ada pesanan aktif" />

            <TextView
                android:id="@+id/kosong_isi"
                style="@style/Teks.IsiKecil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                tools:text="Cari tas kejutan di sekitarmu dan selamatkan makanan hari ini." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tombol_beranda"
                style="@style/Widget.LifeOfFoods.Tombol.Utama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/k15_ke_beranda" />
        </LinearLayout>

        <include
            android:id="@+id/keadaan"
            layout="@layout/include_keadaan_muat" />
    </FrameLayout>

    <include
        android:id="@+id/nav"
        layout="@layout/include_nav_bawah" />
</LinearLayout>
