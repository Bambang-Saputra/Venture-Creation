<?xml version="1.0" encoding="utf-8"?>
<!--
    K19 Edit profil (Figma "K19 · Edit profil"). Foto, nama, nomor HP (hanya dibaca), email, area
    utama, dan baris ke alergi (K05). Kolom sama dengan K04, jadi aturan validasinya juga sama.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_kartu"
    android:orientation="vertical">

    <include
        android:id="@+id/kepala"
        layout="@layout/include_kepala" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/gulir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:id="@+id/kotak_foto"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center_horizontal">

                    <TextView
                        android:id="@+id/inisial"
                        style="@style/Teks.JudulToko"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/teks_merek_gelap"
                        android:textSize="22sp"
                        tools:text="DR" />

                    <ImageView
                        android:id="@+id/foto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/k19_foto_profil"
                        android:visibility="gone" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_ganti_foto"
                    style="@style/Widget.LifeOfFoods.Tombol.Tautan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:minHeight="48dp"
                    android:text="@string/k19_ganti_foto" />

                <TextView
                    style="@style/Teks.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:labelFor="@id/nama"
                    android:text="@string/k04_nama" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/isian_nama"
                    style="@style/IsianBulat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nama"
                        style="@style/IsianTeks"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:autofillHints="name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="120" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/bantuan_nama"
                    style="@style/Teks.Bantuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />

                <TextView
                    style="@style/Teks.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:labelFor="@id/nomor_hp"
                    android:text="@string/k19_nomor_hp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/IsianBulat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nomor_hp"
                        style="@style/IsianTeks"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:enabled="false"
                        android:importantForAutofill="no"
                        android:inputType="phone"
                        tools:text="+62 812-3456-7890" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Teks.Bantuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/k19_nomor_ket" />

                <TextView
                    style="@style/Teks.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:labelFor="@id/email"
                    android:text="@string/k19_email" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/isian_email"
                    style="@style/IsianBulat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        style="@style/IsianTeks"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLength="190" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/bantuan_email"
                    style="@style/Teks.Bantuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />

                <TextView
                    style="@style/Teks.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:labelFor="@id/area"
                    android:text="@string/k19_area" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/isian_area"
                    style="@style/IsianBulat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/area"
                        style="@style/IsianTeks"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:importantForAutofill="no"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords"
                        android:maxLength="120" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/bantuan_area"
                    style="@style/Teks.Bantuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_kotak_lembut_16">

                    <include
                        android:id="@+id/baris_alergi"
                        layout="@layout/item_baris_toko" />
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/keadaan"
            layout="@layout/include_keadaan_muat" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bilah_aksi"
        style="@style/BilahAksi"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombol_simpan"
            style="@style/Widget.LifeOfFoods.Tombol.Utama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/k19_simpan" />
    </LinearLayout>
</LinearLayout>
