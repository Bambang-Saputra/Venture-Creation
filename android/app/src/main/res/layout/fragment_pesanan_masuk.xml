<?xml version="1.0" encoding="utf-8"?>
<!--
    M11 Pesanan masuk (Figma 73:2212, PRD-10). Header: judul, tombol "Cocokkan kode" (M12), tab
    Hari ini / Riwayat. Isi: tiga ubin ringkasan, lalu kartu pesanan. Nav mitra di bawah.
    Tab Riwayat menampilkan riwayat hari ini; daftar riwayat lengkap (M21, SHOULD) menyusul.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_garis_bawah"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Teks.JudulHalaman"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/m11_judul" />

            <TextView
                android:id="@+id/tombol_cocokkan"
                style="@style/Teks.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pil_tombol"
                android:clickable="true"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/m11_cocokkan"
                android:textColor="@color/teks_di_gelap" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_hari_ini"
                style="@style/Teks.JudulKotak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tab_aktif"
                android:minHeight="32dp"
                android:paddingBottom="12dp"
                android:text="@string/m11_tab_hari_ini"
                android:textColor="@color/teks_merek" />

            <TextView
                android:id="@+id/tab_riwayat"
                style="@style/Teks.JudulKotak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:minHeight="32dp"
                android:paddingBottom="12dp"
                android:text="@string/m11_tab_riwayat"
                android:textColor="@color/teks_sekunder" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/gulir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/luring"
                    style="@style/Teks.Bantuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone"
                    tools:text="Offline. Daftar terakhir diperbarui 20.41."
                    tools:visibility="visible" />

                <!-- M21: saringan rentang dan ringkasan (tab Riwayat saja). -->
                <LinearLayout
                    android:id="@+id/kepala_riwayat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/saringan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/saring_7"
                            style="@style/Widget.LifeOfFoods.Chip.Pilihan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/m21_7_hari" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/saring_30"
                            style="@style/Widget.LifeOfFoods.Chip.Pilihan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/m21_30_hari" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/saring_semua"
                            style="@style/Widget.LifeOfFoods.Chip.Pilihan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/m21_semua" />
                    </com.google.android.material.chip.ChipGroup>

                    <LinearLayout
                        android:id="@+id/ringkasan_riwayat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_kotak_lembut_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_laporan"
                            app:tint="@color/teks_sekunder" />

                        <TextView
                            android:id="@+id/teks_ringkasan_riwayat"
                            style="@style/Teks.Isi"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:accessibilityLiveRegion="polite"
                            android:textColor="@color/teks_sekunder"
                            android:textSize="12.5sp"
                            tools:text="Tujuh hari terakhir: 62 pesanan diambil, 3 tidak diambil." />
                    </LinearLayout>
                </LinearLayout>

                <!-- Ringkasan -->
                <LinearLayout
                    android:id="@+id/ringkasan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/ubin_menunggu"
                        layout="@layout/include_ubin_ringkas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/ubin_diambil"
                        layout="@layout/include_ubin_ringkas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/ubin_tidak"
                        layout="@layout/include_ubin_ringkas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/daftar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_pesanan_masuk" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_muat_lagi"
                    style="@style/Widget.LifeOfFoods.Tombol.Lembut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/m21_muat_lagi"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/kosong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tas"
                        app:tint="@color/ikon_redup" />

                    <TextView
                        android:id="@+id/kosong_teks"
                        style="@style/Teks.IsiKecil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        tools:text="Belum ada pesanan hari ini." />

                    <!-- PRD-10: jumlah jualan aktif dan tombol ke M10 (tab Hari ini saja). -->
                    <TextView
                        android:id="@+id/kosong_jualan"
                        style="@style/Teks.Keterangan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:visibility="gone"
                        tools:text="Jualan yang aktif: 2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombol_kelola"
                        style="@style/Widget.LifeOfFoods.Tombol.Lembut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/m11_kelola_jualan"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/keadaan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/progres"
                style="?android:attr/progressBarStyle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminateTint="@color/merek_utama" />

            <LinearLayout
                android:id="@+id/gagal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Teks.JudulKartu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m11_gagal_judul" />

                <TextView
                    android:id="@+id/gagal_isi"
                    style="@style/Teks.IsiKecil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center" />

                <Button
                    android:id="@+id/tombol_coba_lagi"
                    style="@style/Widget.LifeOfFoods.Tombol.Lembut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/coba_lagi" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <include
        android:id="@+id/nav"
        layout="@layout/include_nav_mitra" />
</LinearLayout>
