<?xml version="1.0" encoding="utf-8"?>
<!-- Satu halaman K06: slot foto dengan selubung gelap, lalu kicker, judul, dan isi di atasnya. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_selubung_onboarding">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_gambar"
            app:tint="@color/ikon_redup" />

        <TextView
            style="@style/Teks.Keterangan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/m14_foto"
            android:textColor="@color/ikon_redup" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/kicker"
            style="@style/Teks.Kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/merek_lime"
            tools:text="SATU KORIDOR, PILIHAN PADAT" />

        <TextView
            android:id="@+id/judul"
            style="@style/Teks.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityHeading="true"
            android:textColor="@color/teks_di_gelap"
            tools:text="Makanan layak, harga sepertiga" />

        <TextView
            android:id="@+id/isi"
            style="@style/Teks.Isi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/teks_di_gelap"
            tools:text="Kafe dan bakery di SCBD melepas stok yang tidak habis." />
    </LinearLayout>
</FrameLayout>
