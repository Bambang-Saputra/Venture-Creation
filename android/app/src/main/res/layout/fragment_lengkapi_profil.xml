<?xml version="1.0" encoding="utf-8"?>
<!--
    K04 Lengkapi profil (Figma 56:975). "Tambah foto (opsional)" belum dipasang: API belum punya
    unggah foto (kontrak API bagian "Belum ada di API").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_kartu"
    android:orientation="vertical">

    <include
        android:id="@+id/kepala"
        layout="@layout/include_kepala" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/Teks.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/nama"
                android:text="@string/k04_nama" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/isian_nama"
                style="@style/IsianBulat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nama"
                    style="@style/IsianTeks"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:autofillHints="name"
                    android:hint="@string/k04_nama_contoh"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="120" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/bantuan_nama"
                style="@style/Teks.Bantuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite" />

            <TextView
                style="@style/Teks.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@id/email"
                android:text="@string/k04_email" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/isian_email"
                style="@style/IsianBulat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email"
                    style="@style/IsianTeks"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:autofillHints="emailAddress"
                    android:hint="@string/k04_email_contoh"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLength="255" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/bantuan_email"
                style="@style/Teks.Bantuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/k04_email_bantuan" />

            <TextView
                style="@style/Teks.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@id/area"
                android:text="@string/k04_area" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/isian_area"
                style="@style/IsianBulat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/area"
                    style="@style/IsianTeks"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:autofillHints="postalAddress"
                    android:hint="@string/k04_area_contoh"
                    android:imeOptions="actionDone"
                    android:inputType="textPostalAddress|textCapWords"
                    android:maxLength="120" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/bantuan_area"
                style="@style/Teks.Bantuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/k04_area_bantuan" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progres"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bilah_aksi"
        style="@style/BilahAksi">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombol_lanjut"
            style="@style/Widget.LifeOfFoods.Tombol.Utama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lanjut" />
    </LinearLayout>
</LinearLayout>
