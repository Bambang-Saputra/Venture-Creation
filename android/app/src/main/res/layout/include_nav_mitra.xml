<?xml version="1.0" encoding="utf-8"?>
<!--
    Komponen "Nav mitra": Beranda (M05), Catat (M06), Pesanan (M11), Toko (M14). Sama dengan
    include_nav_bawah konsumen; tab aktif ditandai setSelected(true) pada tab_xxx.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_garis_atas"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/tab_beranda"
        style="@style/TabNav"
        android:contentDescription="@string/nav_beranda">

        <ImageView
            style="@style/TabNavIkon"
            android:src="@drawable/ic_rumah"
            app:tint="@color/nav_bawah_warna" />

        <TextView
            style="@style/Teks.Nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:text="@string/nav_beranda" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_catat"
        style="@style/TabNav"
        android:contentDescription="@string/nav_catat">

        <ImageView
            style="@style/TabNavIkon"
            android:src="@drawable/ic_catat"
            app:tint="@color/nav_bawah_warna" />

        <TextView
            style="@style/Teks.Nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:text="@string/nav_catat" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_pesanan"
        style="@style/TabNav"
        android:contentDescription="@string/nav_pesanan">

        <ImageView
            style="@style/TabNavIkon"
            android:src="@drawable/ic_tas"
            app:tint="@color/nav_bawah_warna" />

        <TextView
            style="@style/Teks.Nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:text="@string/nav_pesanan" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_toko"
        style="@style/TabNav"
        android:contentDescription="@string/nav_toko">

        <ImageView
            style="@style/TabNavIkon"
            android:src="@drawable/ic_toko"
            app:tint="@color/nav_bawah_warna" />

        <TextView
            style="@style/Teks.Nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:text="@string/nav_toko" />
    </LinearLayout>
</LinearLayout>
