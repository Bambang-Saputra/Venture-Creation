<?xml version="1.0" encoding="utf-8"?>
<!--
    K14 Kode pickup (28:557). Kode QR belum ada (M18 Pindai QR berstatus COULD); kasir cukup
    mengetik kode 6 karakter di M12. Kode hanya tampil selama masih bisa ditukar.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradien_tiket"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/isi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Teks.JudulSeksi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.1"
                android:text="@string/k14_pesanan_aktif"
                android:textAllCaps="true"
                android:textColor="@color/teks_di_gelap"
                android:textSize="11.5sp" />

            <LinearLayout
                android:id="@+id/pil_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pil_gelap"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <View
                    android:id="@+id/titik_status"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_titik_status" />

                <TextView
                    android:id="@+id/status"
                    style="@style/Teks.Keterangan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/teks_di_gelap"
                    tools:text="Siap diambil" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!-- Kartu kode -->
        <LinearLayout
            android:id="@+id/kartu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_kartu_kode"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="24dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp"
            android:visibility="invisible"
            tools:visibility="visible">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/petunjuk"
                style="@style/Teks.Keterangan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.12"
                android:text="@string/k14_tunjukkan"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/kode"
                style="@style/Teks.JudulBesar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.08"
                android:textIsSelectable="true"
                android:textSize="40sp"
                app:lineHeight="44sp"
                tools:text="LF7Q2K" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/garis_halus" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/baris_mitra"
                    layout="@layout/include_baris_tiket" />

                <include
                    android:id="@+id/baris_jam"
                    layout="@layout/include_baris_tiket" />

                <include
                    android:id="@+id/baris_jumlah"
                    layout="@layout/include_baris_tiket" />

                <include
                    android:id="@+id/baris_bayar"
                    layout="@layout/include_baris_tiket" />
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/keadaan"
            layout="@layout/include_keadaan_muat"
            android:visibility="gone" />

        <!-- Dampak -->
        <LinearLayout
            android:id="@+id/dampak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_kotak_dampak"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_daun"
                app:tint="@color/merek_lime" />

            <TextView
                android:id="@+id/dampak_teks"
                style="@style/Teks.Catatan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/teks_di_gelap"
                tools:text="Pesanan ini menyelamatkan 2 porsi dari tempat sampah." />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tombol_pesanan_saya"
                style="@style/Widget.LifeOfFoods.Tombol.Garis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/k14_pesanan_saya"
                android:textColor="@color/teks_di_gelap"
                app:strokeColor="#4DFFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tombol_cari_lagi"
                style="@style/Widget.LifeOfFoods.Tombol.Utama"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/latar_kartu"
                android:text="@string/k14_cari_lagi"
                android:textColor="@color/teks_merek_gelap" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
