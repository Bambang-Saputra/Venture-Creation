<?xml version="1.0" encoding="utf-8"?>
<!--
    K14 Kode pickup (Figma "Layar aplikasi", PRD-07). Gradasi hijau, kartu putih berisi kode besar.

    Beda dengan Figma, disengaja:
    - QR code tidak ada: PRD-07 menaruhnya di luar lingkup (untuk M18 Pindai QR, COULD).
    - "Dibayar" diganti "Bayar di tempat", karena selama pilot tidak ada pembayaran di aplikasi.
    - Kotak dampak hanya menyebut porsi pesanan ini; API belum mengirim total porsi dan CO2e.
    - Tautan "Buka di Google Maps" dan "Batalkan pesanan" ditambahkan (PRD-07 alur 3 dan 4).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradien_kode"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/isi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="12dp"
            android:paddingEnd="22dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Teks.Kapital"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/k14_pesanan_aktif"
                    android:textColor="@color/teks_di_gelap" />

                <LinearLayout
                    android:id="@+id/pil_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_gelap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:visibility="invisible"
                    tools:visibility="visible">

                    <View
                        android:id="@+id/titik_status"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_titik_status" />

                    <TextView
                        android:id="@+id/teks_status"
                        style="@style/Teks.Lencana"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="7dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="0dp"
                        android:textColor="@color/teks_di_gelap"
                        tools:text="Siap diambil" />
                </LinearLayout>
            </LinearLayout>

            <!-- Kartu kode -->
            <LinearLayout
                android:id="@+id/kartu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="72dp"
                android:background="@drawable/bg_kartu_putih"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="26dp"
                android:paddingEnd="22dp"
                android:paddingBottom="22dp"
                android:visibility="invisible"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_logo" />

                <!-- Pesanan masih bisa diambil -->
                <LinearLayout
                    android:id="@+id/blok_kode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Teks.Kapital"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/k14_tunjukkan"
                        android:textColor="@color/teks_kuat" />

                    <TextView
                        android:id="@+id/kode"
                        style="@style/Teks.KodePickup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textIsSelectable="true"
                        tools:text="LF7Q2K" />
                </LinearLayout>

                <!-- Selesai, dibatalkan, atau tidak diambil -->
                <LinearLayout
                    android:id="@+id/blok_akhir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/judul_akhir"
                        style="@style/Teks.JudulSeksi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        tools:text="Selesai, selamat menikmati" />

                    <TextView
                        android:id="@+id/isi_akhir"
                        style="@style/Teks.IsiKecil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        tools:text="Kasir sudah menukar kodemu." />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/garis_halus" />

                <include
                    android:id="@+id/baris_mitra"
                    layout="@layout/include_baris_info" />

                <include
                    android:id="@+id/baris_jam"
                    layout="@layout/include_baris_info" />

                <include
                    android:id="@+id/baris_jumlah"
                    layout="@layout/include_baris_info" />

                <include
                    android:id="@+id/baris_bayar"
                    layout="@layout/include_baris_info" />
            </LinearLayout>

            <TextView
                android:id="@+id/luring"
                style="@style/Teks.Bantuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/teks_di_gelap"
                android:visibility="gone"
                tools:text="Offline. Terakhir diperbarui 20.41."
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/dampak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_kotak_dampak"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_daun"
                    app:tint="@color/merek_lime" />

                <TextView
                    android:id="@+id/teks_dampak"
                    style="@style/Teks.Catatan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/teks_di_gelap"
                    tools:text="Pesanan ini menyelamatkan 2 porsi dari terbuang." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tautan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_maps"
                    style="@style/Widget.LifeOfFoods.Tombol.TautanPutih"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/k14_buka_maps"
                    app:icon="@drawable/ic_pin_lokasi"
                    app:iconSize="15dp"
                    app:iconTint="@color/teks_di_gelap" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_batal"
                    style="@style/Widget.LifeOfFoods.Tombol.TautanPutih"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/k14_batalkan" />
            </LinearLayout>

            <include
                android:id="@+id/keadaan"
                layout="@layout/include_keadaan_muat" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bilah_aksi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombol_pesanan_saya"
            style="@style/Widget.LifeOfFoods.Tombol.GarisPutih"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/k14_pesanan_saya" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombol_cari_lagi"
            style="@style/Widget.LifeOfFoods.Tombol.Putih"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/k14_cari_lagi" />
    </LinearLayout>
</LinearLayout>
