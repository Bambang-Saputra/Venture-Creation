<?xml version="1.0" encoding="utf-8"?>
<!--
    Satu akun di kartu "Akun kasir" M15: avatar inisial, nama, nomor HP, pil peran. Pil gelap
    "Pemilik", pil terang "Kasir". Baris kasir bisa diketuk untuk mencabut akses.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/inisial"
        style="@style/Teks.JudulKartu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_avatar"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/teks_merek_gelap"
        tools:text="KP" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nama"
            style="@style/Teks.JudulKartu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/teks_utama"
            tools:text="Kalyan Pratama" />

        <TextView
            android:id="@+id/nomor"
            style="@style/Teks.Isi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/teks_sekunder"
            android:textSize="13sp"
            tools:text="0812-9988-7766" />
    </LinearLayout>

    <TextView
        android:id="@+id/peran"
        style="@style/Teks.Pil"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        tools:background="@drawable/bg_chip_gelap"
        tools:text="Pemilik"
        tools:textColor="@color/teks_di_gelap" />
</LinearLayout>
