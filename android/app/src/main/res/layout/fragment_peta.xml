<?xml version="1.0" encoding="utf-8"?>
<!--
    K08 Peta (Figma "K08 · Peta"), versi daftar sesuai ADR-0005: peta di dalam aplikasi butuh
    penagihan Google Maps, jadi jualan tampil berurut jarak dan peta dibuka di aplikasi peta HP.

    Beda dengan Figma, disengaja:
    - Tab Peta/Daftar diganti tombol "Lihat di Google Maps" (geo:) dan tombol rute per kartu.
    - Chip "Tersedia sekarang / Habis / Favorit" diganti pilihan jarak: API beranda hanya mengirim
      jualan yang bisa dipesan, dan favorit sudah punya layar sendiri (K16).
    - Filter alergi dari profil tetap berlaku, sama dengan beranda.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <include
        android:id="@+id/kepala"
        layout="@layout/include_kepala" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/gulir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/isi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/jarak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/jarak_semua"
                            style="@style/Widget.LifeOfFoods.Chip.Pilihan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/k08_semua" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/jarak_1"
                            style="@style/Widget.LifeOfFoods.Chip.Pilihan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/jarak_3"
                            style="@style/Widget.LifeOfFoods.Chip.Pilihan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/jarak_5"
                            style="@style/Widget.LifeOfFoods.Chip.Pilihan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_buka_peta"
                    style="@style/Widget.LifeOfFoods.Tombol.Garis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/k08_buka_peta"
                    app:icon="@drawable/ic_peta"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <TextView
                    android:id="@+id/tanpa_lokasi"
                    style="@style/Teks.Isi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_kotak_lembut_12"
                    android:padding="12dp"
                    android:text="@string/k08_tanpa_lokasi"
                    android:textColor="@color/teks_sekunder"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/daftar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/kosong"
                    style="@style/Teks.Isi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:text="@string/k08_kosong"
                    android:textColor="@color/teks_sekunder"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_muat_lagi"
                    style="@style/Widget.LifeOfFoods.Tombol.Lembut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/m21_muat_lagi"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/keadaan"
            layout="@layout/include_keadaan_muat" />
    </FrameLayout>
</LinearLayout>
