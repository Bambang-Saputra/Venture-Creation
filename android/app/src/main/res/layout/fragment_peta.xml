<?xml version="1.0" encoding="utf-8"?>
<!--
    K08 Peta (Figma "K08 · Peta"). Tab Peta memakai osmdroid dengan ubin OpenStreetMap, tanpa API
    key (ADR-0005, revisi Oktober 2026). Tab Daftar berisi jualan berurut jarak dengan tombol rute
    yang membuka aplikasi peta HP lewat geo:.

    Beda dengan Figma, disengaja:
    - Chip "Tersedia sekarang / Habis / Favorit" diganti pilihan jarak: API beranda hanya mengirim
      jualan yang bisa dipesan, dan favorit sudah punya layar sendiri (K16).
    - Satu penanda per toko (harga termurah); jualan lain toko itu ada di tab Daftar.
    - Atribusi "© OpenStreetMap" wajib tampil di pojok peta (lisensi ODbL).
    - Filter alergi dari profil tetap berlaku, sama dengan beranda.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/atas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/latar_kartu"
        android:orientation="vertical">

        <include
            android:id="@+id/kepala"
            layout="@layout/include_kepala" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/tab_peta"
                style="@style/Teks.JudulKotak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tab_aktif"
                android:minHeight="32dp"
                android:paddingBottom="12dp"
                android:text="@string/k08_tab_peta"
                android:textColor="@color/teks_merek" />

            <TextView
                android:id="@+id/tab_daftar"
                style="@style/Teks.JudulKotak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:minHeight="32dp"
                android:paddingBottom="12dp"
                android:text="@string/k08_tab_daftar"
                android:textColor="@color/teks_sekunder" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/garis_tegas" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/jarak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/jarak_semua"
                    style="@style/Widget.LifeOfFoods.Chip.Pilihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/k08_semua" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/jarak_1"
                    style="@style/Widget.LifeOfFoods.Chip.Pilihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/jarak_3"
                    style="@style/Widget.LifeOfFoods.Chip.Pilihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/jarak_5"
                    style="@style/Widget.LifeOfFoods.Chip.Pilihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab Peta -->
        <FrameLayout
            android:id="@+id/panel_peta"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <org.osmdroid.views.MapView
                android:id="@+id/peta"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/k08_peta_isi" />

            <TextView
                android:id="@+id/atribusi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="#CCFFFFFF"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="@string/k08_atribusi_osm"
                android:textColor="@color/teks_sekunder"
                android:textSize="10sp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/tombol_lokasiku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/k08_lokasiku"
                android:src="@drawable/ic_pin_lokasi"
                app:backgroundTint="@color/latar_kartu"
                app:fabSize="mini"
                app:tint="@color/teks_merek" />

            <FrameLayout
                android:id="@+id/kartu_terpilih"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp" />
        </FrameLayout>

        <!-- Tab Daftar -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/gulir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/isi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_buka_peta"
                    style="@style/Widget.LifeOfFoods.Tombol.Garis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/k08_buka_peta"
                    app:icon="@drawable/ic_peta"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <TextView
                    android:id="@+id/tanpa_lokasi"
                    style="@style/Teks.Isi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_kotak_lembut_12"
                    android:padding="12dp"
                    android:text="@string/k08_tanpa_lokasi"
                    android:textColor="@color/teks_sekunder"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/daftar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/kosong"
                    style="@style/Teks.Isi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:text="@string/k08_kosong"
                    android:textColor="@color/teks_sekunder"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_muat_lagi"
                    style="@style/Widget.LifeOfFoods.Tombol.Lembut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/m21_muat_lagi"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/keadaan"
            layout="@layout/include_keadaan_muat"
            tools:visibility="gone" />
    </FrameLayout>
</LinearLayout>
