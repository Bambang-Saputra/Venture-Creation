<?xml version="1.0" encoding="utf-8"?>
<!--
    K20 Pengaturan (Figma "K20 · Pengaturan"). Tiga sakelar notifikasi (PATCH /me per sakelar), akun
    (alergi), keluar, dan hapus akun.

    Beda dengan Figma, disengaja: "Metode pembayaran" (bayar di tempat, ADR-0004), "Bahasa" (hanya
    Indonesia), "Privasi dan data", "Pusat bantuan" dan "Syarat layanan" (K23, belum ada isinya)
    tidak ditampilkan supaya tidak ada baris yang tidak membuka apa-apa.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <include
        android:id="@+id/kepala"
        layout="@layout/include_kepala" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/gulir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/isi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_kartu_20"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Teks.JudulKartu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/k20_notifikasi"
                        android:textColor="@color/teks_utama" />

                    <include
                        android:id="@+id/sakelar_favorit"
                        layout="@layout/item_sakelar" />

                    <include
                        android:id="@+id/sakelar_pengingat"
                        layout="@layout/item_sakelar" />

                    <include
                        android:id="@+id/sakelar_promo"
                        layout="@layout/item_sakelar" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_kartu_20"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="6dp">

                    <TextView
                        style="@style/Teks.JudulKartu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="4dp"
                        android:accessibilityHeading="true"
                        android:text="@string/k20_akun"
                        android:textColor="@color/teks_utama" />

                    <include
                        android:id="@+id/baris_alergi"
                        layout="@layout/item_baris_toko" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_keluar"
                    style="@style/Widget.LifeOfFoods.Tombol.Garis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/k20_keluar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_hapus"
                    style="@style/Widget.LifeOfFoods.Tombol.Tautan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/k20_hapus"
                    android:textColor="@color/tanda_bahaya_teks" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/keadaan"
            layout="@layout/include_keadaan_muat" />
    </FrameLayout>
</LinearLayout>
