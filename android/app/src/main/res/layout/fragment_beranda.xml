<?xml version="1.0" encoding="utf-8"?>
<!--
    K07 Beranda (Figma 22:79). Header tetap di atas, isi bergulir, Nav bawah tetap di bawah.
    Karusel promo (voucher K22 dan mitra sorotan) belum dipasang: voucher berstatus WON'T dan API
    belum punya data promo, jadi kartu statis hanya akan menampilkan penawaran palsu.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <!-- ===== Header ===== -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_garis_bawah"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo" />

            <LinearLayout
                android:id="@+id/lokasi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    style="@style/Teks.Keterangan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/k07_lokasi_kamu" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pin_lokasi"
                        app:tint="@color/merek_utama" />

                    <TextView
                        android:id="@+id/area"
                        style="@style/Teks.JudulSeksi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxWidth="180dp"
                        android:maxLines="1"
                        tools:text="SCBD, Jakarta Selatan" />

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_bawah"
                        app:tint="@color/teks_sekunder" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/tombol_notifikasi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tombol_ikon"
                android:clickable="true"
                android:contentDescription="@string/k07_notifikasi"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lonceng"
                    app:tint="@color/teks_utama" />

                <View
                    android:id="@+id/titik_notifikasi"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_titik_notifikasi"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <TextView
                android:id="@+id/avatar"
                style="@style/Teks.JudulSeksi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_avatar"
                android:contentDescription="@string/k07_profil"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:textColor="@color/teks_merek_gelap"
                android:textSize="13sp"
                tools:text="DR" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/kolom_cari"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_isian_14"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cari"
                    app:tint="@color/teks_sekunder" />

                <TextView
                    style="@style/Teks.Petunjuk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/k07_cari" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/tombol_peta"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_tombol_gelap"
                android:contentDescription="@string/k07_peta"
                android:foreground="?attr/selectableItemBackground"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_peta"
                app:tint="@color/teks_di_gelap" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Isi ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/gulir"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="18dp">

            <!-- Penanda filter (PRD-04 kriteria 5): ada jualan yang disembunyikan. -->
            <LinearLayout
                android:id="@+id/penanda_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_catatan_merek"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_filter"
                    app:tint="@color/merek_utama" />

                <TextView
                    android:id="@+id/teks_penanda_filter"
                    style="@style/Teks.IsiKecil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/teks_merek_gelap" />

                <TextView
                    style="@style/Teks.Tautan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:importantForAccessibility="no"
                    android:text="@string/k07_filter_ubah" />
            </LinearLayout>

            <TextView
                style="@style/Teks.JudulSeksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="@string/k07_kategori" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <include
                    android:id="@+id/kategori_bakery"
                    layout="@layout/include_ubin_kategori" />

                <include
                    android:id="@+id/kategori_kafe"
                    layout="@layout/include_ubin_kategori" />

                <include
                    android:id="@+id/kategori_restoran"
                    layout="@layout/include_ubin_kategori" />

                <include
                    android:id="@+id/kategori_katering"
                    layout="@layout/include_ubin_kategori" />

                <include
                    android:id="@+id/kategori_swalayan"
                    layout="@layout/include_ubin_kategori" />
            </LinearLayout>

            <!-- Disembunyikan kalau tidak ada jualan yang jam ambilnya berakhir < 60 menit. -->
            <LinearLayout
                android:id="@+id/bagian_segera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_api"
                        app:tint="@color/tanda_api" />

                    <TextView
                        style="@style/Teks.JudulSeksi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/k07_segera_tutup" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/daftar_segera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_kartu_flash" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/judul_terdekat"
                        style="@style/Teks.JudulSeksi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/k07_terdekat" />

                    <TextView
                        android:id="@+id/lihat_semua"
                        style="@style/Teks.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:text="@string/k07_lihat_semua"
                        android:textColor="@color/teks_merek" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/daftar_terdekat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_kartu_tas" />

                <ProgressBar
                    android:id="@+id/progres"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:indeterminateTint="@color/merek_utama"
                    android:visibility="gone" />

                <!-- Kosong atau gagal; teksnya diatur fragment. -->
                <LinearLayout
                    android:id="@+id/keadaan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_kartu_jualan"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/keadaan_judul"
                        style="@style/Teks.JudulKartu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/keadaan_isi"
                        style="@style/Teks.IsiKecil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center" />

                    <Button
                        android:id="@+id/tombol_coba_lagi"
                        style="@style/Widget.LifeOfFoods.Tombol.Lembut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/coba_lagi" />

                    <!-- Kosong karena filter: perluas jarak atau buka K09. -->
                    <Button
                        android:id="@+id/tombol_ubah_filter"
                        style="@style/Widget.LifeOfFoods.Tombol.Lembut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/k07_atur_filter"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/nav"
        layout="@layout/include_nav_bawah" />
</LinearLayout>
