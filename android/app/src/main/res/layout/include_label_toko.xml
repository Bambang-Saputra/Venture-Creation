<?xml version="1.0" encoding="utf-8"?>
<!-- Kotak saklar M09/M16: Halal, dan Dapur juga mengolah kacang (kacang tanah "mungkin"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_isian_14"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/baris_halal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Teks.Butir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/saklar_halal"
                android:text="@string/m09_halal" />

            <TextView
                android:id="@+id/ket_halal"
                style="@style/Teks.Bantuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/m09_halal_ket" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/saklar_halal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/m09_halal"
            app:thumbTint="@color/latar_kartu"
            app:trackDecorationTint="@android:color/transparent"
            app:trackTint="@color/saklar_jalur" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Teks.Butir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/saklar_kacang"
                android:text="@string/m09_dapur_kacang" />

            <TextView
                style="@style/Teks.Bantuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/m09_dapur_kacang_ket" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/saklar_kacang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/m09_dapur_kacang"
            app:thumbTint="@color/latar_kartu"
            app:trackDecorationTint="@android:color/transparent"
            app:trackTint="@color/saklar_jalur" />
    </LinearLayout>
</LinearLayout>
