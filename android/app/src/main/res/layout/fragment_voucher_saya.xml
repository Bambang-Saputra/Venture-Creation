<?xml version="1.0" encoding="utf-8"?>
<!--
    K22 Voucher saya (ADR-0008). Kartu Gosok & Menang di atas, voucher pop up yang belum diklaim,
    lalu voucher milik pembeli yang masih berlaku.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <include
        android:id="@+id/kepala"
        layout="@layout/include_kepala" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/gulir"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/kartu_gosok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_kotak_war"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_hitung_mundur"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_hadiah"
                    app:tint="@color/teks_di_gelap" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Teks.TombolWar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gosok_judul" />

                    <TextView
                        android:id="@+id/ket_gosok"
                        style="@style/Teks.WarSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/gosok_ajak" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/kotak_promo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Teks.JudulSeksi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/k22_bisa_diklaim" />

                <include
                    android:id="@+id/kartu_promo"
                    layout="@layout/item_voucher"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tombol_klaim"
                    style="@style/Teks.TombolWar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_tombol_war"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/k22_klaim" />
            </LinearLayout>

            <TextView
                style="@style/Teks.JudulSeksi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/k22_milikku" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/daftar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@layout/item_voucher" />

            <TextView
                android:id="@+id/kosong"
                style="@style/Teks.IsiKecil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_kartu_jualan"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/k22_kosong"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progres"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:indeterminateTint="@color/merek_utama" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
