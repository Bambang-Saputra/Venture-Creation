<?xml version="1.0" encoding="utf-8"?>
<!--
    M16 Pasang menu satuan (Figma 127:2661, PRD-09). Jenis jualan (segmen ke M09), "Item hari ini"
    dari produk toko, catatan kandungan, jam ambil, label toko, lalu potensi dan "Terbitkan menu".

    Beda dengan Figma, disengaja:
    - Tiap item punya kolom harga jual, karena harga produk di API adalah harga normal (jadi harga
      coret), dan tombol alergen untuk pernyataan alergen per item (PRD-09 kriteria 10).
    - "Tambah item dari menu toko" tidak ada: semua produk aktif sudah tampil; stok 0 = tidak dijual.
      Gantinya "Tambah menu baru" untuk mendaftarkan menu yang belum ada (POST /products).
    - Jam ambil memakai pemilih jam.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <include
        android:id="@+id/kepala"
        layout="@layout/include_kepala" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/gulir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/Teks.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/m09_jenis" />

                <include
                    android:id="@+id/segmen"
                    layout="@layout/include_segmen_jualan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    style="@style/Teks.Bantuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/m16_jenis_ket" />

                <!-- Item hari ini -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_kartu_jualan"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="12dp"
                        android:paddingBottom="6dp">

                        <TextView
                            style="@style/Teks.JudulKotak"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/m16_item_hari_ini" />

                        <TextView
                            style="@style/Teks.Keterangan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/m16_stok" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/daftar_produk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/kosong"
                        style="@style/Teks.IsiKecil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="12dp"
                        android:text="@string/m16_kosong"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombol_menu_baru"
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:minHeight="48dp"
                        android:text="@string/m16_menu_baru"
                        android:textColor="@color/merek_utama"
                        app:icon="@drawable/ic_tambah"
                        app:iconTint="@color/merek_utama" />
                </LinearLayout>

                <TextView
                    android:id="@+id/galat_item"
                    style="@style/Teks.Bantuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/tanda_bahaya_teks"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_pil_isian_14"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        app:tint="@color/teks_kuat" />

                    <TextView
                        style="@style/Teks.Catatan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/m16_catatan"
                        android:textColor="@color/teks_kuat" />
                </LinearLayout>

                <include
                    android:id="@+id/jam"
                    layout="@layout/include_pilih_jam" />

                <include
                    android:id="@+id/label_toko"
                    layout="@layout/include_label_toko"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/keadaan"
            layout="@layout/include_keadaan_muat" />
    </FrameLayout>

    <include
        android:id="@+id/aksi"
        layout="@layout/include_bilah_potensi" />
</LinearLayout>
