<?xml version="1.0" encoding="utf-8"?>
<!-- Baris item K12 (tas kejutan): slot foto 48, nama, keterangan, dan "1 × Rp18.000". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_kotak_lembut_12">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_gambar"
            app:tint="@color/ikon_redup" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/judul"
            style="@style/Teks.JudulKartuKecil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Tas Pastry Sore" />

        <TextView
            style="@style/Teks.NamaToko"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/k12_isi_dipilih" />
    </LinearLayout>

    <TextView
        android:id="@+id/jumlah"
        style="@style/Teks.Butir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="1 × Rp18.000" />
</LinearLayout>
