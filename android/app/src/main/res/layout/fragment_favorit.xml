<?xml version="1.0" encoding="utf-8"?>
<!--
    K16 Favorit (Figma 60:1263, PRD-22). Header putih dengan judul, daftar kartu mitra favorit,
    kartu sakelar "Kabari saat mitra favorit memasang tas", lalu Nav bawah dengan tab Favorit.

    Beda dengan Figma, disengaja: tab "Tas" tidak ditampilkan. Tabel favorites hanya menyimpan
    toko, sedangkan jualan berganti setiap hari, jadi tidak ada tas yang bisa disimpan.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_garis_bawah"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp">

        <TextView
            style="@style/Teks.JudulHalaman"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/k16_judul" />

        <TextView
            style="@style/Teks.JudulKotak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tab_aktif"
            android:minHeight="32dp"
            android:paddingBottom="12dp"
            android:text="@string/k16_tab_mitra"
            android:textColor="@color/teks_merek" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/gulir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/daftar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Kosong: ajakan memakai tombol hati di detail jualan. -->
                <LinearLayout
                    android:id="@+id/kosong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_hati"
                        app:tint="@color/ikon_redup" />

                    <TextView
                        style="@style/Teks.JudulKartu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/k16_kosong_judul" />

                    <TextView
                        style="@style/Teks.IsiKecil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/k16_kosong_isi" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombol_beranda"
                        style="@style/Widget.LifeOfFoods.Tombol.Utama"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/k15_ke_beranda" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/kotak_kabari"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_kartu_jualan"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <include
                        android:id="@+id/kabari"
                        layout="@layout/item_sakelar" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/keadaan"
            layout="@layout/include_keadaan_muat" />
    </FrameLayout>

    <include
        android:id="@+id/nav"
        layout="@layout/include_nav_bawah" />
</LinearLayout>
