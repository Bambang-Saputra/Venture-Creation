<?xml version="1.0" encoding="utf-8"?>
<!-- K05 Alergi dan pantangan (Figma 56:1033). Chip dibangun dari GET /allergens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_kartu"
    android:orientation="vertical">

    <include
        android:id="@+id/kepala"
        layout="@layout/include_kepala" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/Teks.Isi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/k05_keterangan" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progres_muat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/gagal_muat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Teks.IsiKecil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/k05_gagal_muat" />

                <Button
                    android:id="@+id/tombol_coba_lagi"
                    style="@style/Widget.LifeOfFoods.Tombol.Tautan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/coba_lagi" />
            </LinearLayout>

            <TextView
                android:id="@+id/judul_alergi"
                style="@style/Teks.JudulSeksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityHeading="true"
                android:text="@string/k05_alergi"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grup_alergi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

            <TextView
                android:id="@+id/judul_diet"
                style="@style/Teks.JudulSeksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityHeading="true"
                android:text="@string/k05_pola_makan"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grup_diet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_catatan_merek"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info" />

                <TextView
                    style="@style/Teks.IsiKecil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/k05_catatan"
                    android:textColor="@color/teks_merek_gelap" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progres"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout style="@style/BilahAksi">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombol_lewati"
            style="@style/Widget.LifeOfFoods.Tombol.Lembut"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/lewati" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombol_simpan"
            style="@style/Widget.LifeOfFoods.Tombol.Utama"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/simpan" />
    </LinearLayout>
</LinearLayout>
