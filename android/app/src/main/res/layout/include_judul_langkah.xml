<?xml version="1.0" encoding="utf-8"?>
<!-- Judul langkah bernomor beserta penjelasannya (M09). Teks diisi dari kode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nomor"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_nomor_langkah"
            android:fontFamily="@font/gabarito_extrabold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/teks_di_gelap"
            android:textSize="13sp"
            tools:text="1" />

        <TextView
            android:id="@+id/judul"
            style="@style/Teks.JudulSeksi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            tools:text="Pilih isi tas" />
    </LinearLayout>

    <TextView
        android:id="@+id/ket"
        style="@style/Teks.Bantuan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:layout_marginTop="4dp"
        tools:text="Pakai cetakan tas yang sudah tersimpan, atau pilih Tas campur." />
</LinearLayout>
