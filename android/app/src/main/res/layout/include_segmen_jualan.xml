<?xml version="1.0" encoding="utf-8"?>
<!-- Komponen "Segmen" M09/M10/M16/M17: Tas kejutan / Menu satuan. Pilihan aktif diatur dari kode
     lewat setSelected pada tab_tas atau tab_menu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_segmen"
    android:orientation="horizontal"
    android:padding="4dp">

    <TextView
        android:id="@+id/tab_tas"
        style="@style/Teks.Butir"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:background="@drawable/bg_segmen_pilihan"
        android:gravity="center"
        android:text="@string/m10_tas_kejutan"
        android:textColor="@color/segmen_teks" />

    <TextView
        android:id="@+id/tab_menu"
        style="@style/Teks.Butir"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_segmen_pilihan"
        android:gravity="center"
        android:text="@string/m10_menu_satuan"
        android:textColor="@color/segmen_teks" />
</LinearLayout>
