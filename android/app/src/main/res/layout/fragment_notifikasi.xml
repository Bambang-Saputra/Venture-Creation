<?xml version="1.0" encoding="utf-8"?>
<!--
    K17 Notifikasi (Figma "K17 · Notifikasi"), PRD-18. Dikelompokkan per hari. Notifikasi pesanan
    membuka K14. Semua ditandai dibaca begitu daftar tampil, jadi titik di lonceng K07 hilang.

    Beda dengan Figma, disengaja: contoh "Cek kandungan sebelum pesan" dan voucher belum dibuat
    server (kontrak API bagian 12), jadi hanya jenis yang benar-benar dikirim server yang tampil.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_kartu"
    android:orientation="vertical">

    <include
        android:id="@+id/kepala"
        layout="@layout/include_kepala" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/gulir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/isi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/daftar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/kosong"
                    style="@style/Teks.Isi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:text="@string/k17_kosong"
                    android:textColor="@color/teks_sekunder"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombol_muat_lagi"
                    style="@style/Widget.LifeOfFoods.Tombol.Lembut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/m21_muat_lagi"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/keadaan"
            layout="@layout/include_keadaan_muat" />
    </FrameLayout>
</LinearLayout>
