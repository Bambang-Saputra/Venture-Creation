<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog "Tambah item lain" M06/M19: nama, jumlah (M06) atau berat (M19), nilai per satuan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/IsianBulat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/m06_dialog_nama">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nama_lain"
            style="@style/IsianTeks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="140" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/isian_banyak"
        style="@style/IsianBulat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/m06_dialog_jumlah">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/banyak_lain"
            style="@style/IsianTeks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="6" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/IsianBulat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/m06_dialog_nilai">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nilai_lain"
            style="@style/IsianTeks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="7" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
