<?xml version="1.0" encoding="utf-8"?>
<!-- activated = kode salah (merah), selected = kotak yang sedang diisi (hijau). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/tanda_bahaya_latar" />
            <stroke android:width="1.5dp" android:color="@color/tanda_bahaya_teks" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/latar_kartu" />
            <stroke android:width="2dp" android:color="@color/merek_utama" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/latar_kartu" />
            <stroke android:width="1dp" android:color="@color/garis_tegas" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
