<?xml version="1.0" encoding="utf-8"?>
<!-- Ubin kategori K07: kotak 62dp putih, sudut 20dp. Terpilih (selected) bergaris merek. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/latar_merek_lembut" />
            <stroke
                android:width="1.5dp"
                android:color="@color/merek_utama" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/latar_kartu" />
            <stroke
                android:width="1dp"
                android:color="@color/garis_halus" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
