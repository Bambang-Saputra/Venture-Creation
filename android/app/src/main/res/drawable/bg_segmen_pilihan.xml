<?xml version="1.0" encoding="utf-8"?>
<!-- Pilihan segmen: latar merek lembut saat terpilih, transparan (dengan riak) saat tidak. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_segmen_aktif" android:state_selected="true" />
    <item>
        <ripple android:color="@color/garis_halus">
            <item android:id="@android:id/mask">
                <shape>
                    <solid android:color="@android:color/white" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
