<?xml version="1.0" encoding="utf-8"?>
<!-- Bingkai tombol kembali 40x40 (radius 12, garis E8EFE9) di dalam area sentuh 48dp. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:inset="4dp">
            <shape>
                <solid android:color="@color/latar_lembut" />
                <stroke android:width="1dp" android:color="@color/garis_halus" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="4dp">
            <shape>
                <solid android:color="@color/latar_kartu" />
                <stroke android:width="1dp" android:color="@color/garis_halus" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
</selector>
