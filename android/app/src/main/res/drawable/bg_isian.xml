<?xml version="1.0" encoding="utf-8"?>
<!--
    Kotak kolom isian buatan sendiri (dipakai bila TextInputLayout tidak cukup, misalnya awalan +62
    dengan pemisah di K02). Pasang addStatesFromChildren di induknya supaya ikut fokus.
    activated = galat.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/latar_kartu" />
            <stroke android:width="1.5dp" android:color="@color/tanda_bahaya_teks" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/latar_kartu" />
            <stroke android:width="1.5dp" android:color="@color/merek_utama" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/latar_kartu" />
            <stroke android:width="1dp" android:color="@color/garis_tegas" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
